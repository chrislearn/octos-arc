    {
      "server_name": "codex_apps",
      "supports_parallel_tool_calls": false,
      "server_origin": null,
      "tool_name": "_get_page_sharing",
      "tool_namespace": "codex_apps__chatgpt_space",
      "namespace_description": "Read, search, create, and edit pages and spaces in ChatGPT Space, within your current account.",
      "tool": {
        "name": "chatgpt_space.get_page_sharing",
        "title": "get_page_sharing",
        "description": "Read a Page's sharing policy and your permissions. Drive sharing returns direct and read-only inherited grants and visible sources; complete=false never means no access. A Space-root Page returns its Space sharing snapshot and space_id; use get_space_sharing and update_space_sharing for changes. Library child Pages return canonical Library shares and workspace_id for workspace sharing, even before a workspace grant exists. They have no revision precondition.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "page_id": {
              "description": "Exact Page ID, including any prefix. For a Space's home Page, use its root_page_id. For a page_space_ Space ID, use get_space_sharing with space_id instead.",
              "maxLength": 256,
              "minLength": 1,
              "title": "Page Id",
              "type": "string"
            }
          },
          "required": [
            "page_id"
          ],
          "title": "_GetPageSharingArguments",
          "type": "object"
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "inherited_access": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "complete": {
                      "type": "boolean",
                      "description": "False means some inherited sources could not be read, not that no inherited access exists."
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "recipient": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "recipient_type": {
                                    "type": "string",
                                    "const": "principal"
                                  },
                                  "principal_type": {
                                    "type": "string",
                                    "enum": [
                                      "user",
                                      "group",
                                      "workspace"
                                    ]
                                  },
                                  "principal_id": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "recipient_type",
                                  "principal_type",
                                  "principal_id"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "viewer",
                              "commenter",
                              "editor"
                            ]
                          },
                          "source": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "enum": [
                                      "page",
                                      "space"
                                    ]
                                  },
                                  "id": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "kind",
                                  "id"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "recipient_display_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "recipient",
                          "role",
                          "source",
                          "recipient_display_name"
                        ],
                        "description": "A read-only ancestor grant. Hidden recipients and source identifiers are redacted; edit access at the visible source, not through this child."
                      }
                    }
                  },
                  "required": [
                    "complete",
                    "sources"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional inherited grant information. Unavailable information does not block edits to direct grants."
            },
            "mutation": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "object",
                      "properties": {
                        "resource_type": {
                          "type": "string",
                          "const": "library_folder"
                        },
                        "resource_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "resource_type",
                        "resource_id"
                      ]
                    },
                    "share_id": {
                      "type": "string",
                      "description": "Canonical Library invitation ID."
                    },
                    "recipient": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "recipient_type": {
                              "type": "string",
                              "const": "principal"
                            },
                            "principal_type": {
                              "type": "string",
                              "enum": [
                                "user",
                                "group",
                                "workspace"
                              ]
                            },
                            "principal_id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "recipient_type",
                            "principal_type",
                            "principal_id"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "recipient_type": {
                              "type": "string",
                              "const": "email"
                            },
                            "email": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "recipient_type",
                            "email"
                          ]
                        }
                      ]
                    },
                    "recipient_display_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "recipient_email": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "recipient_avatar_url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "role_id": {
                      "type": "string",
                      "description": "Current Library folder role ID."
                    },
                    "inviter": {
                      "type": "object",
                      "properties": {
                        "principal_type": {
                          "type": "string",
                          "enum": [
                            "user",
                            "group",
                            "workspace"
                          ]
                        },
                        "principal_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "principal_type",
                        "principal_id"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "active"
                      ]
                    },
                    "expires_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "share_id",
                    "resource",
                    "recipient",
                    "role_id",
                    "inviter",
                    "status"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "share_id": {
                      "type": "string",
                      "description": "Canonical Library invitation ID."
                    },
                    "recipient": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "recipient_type": {
                              "type": "string",
                              "const": "principal"
                            },
                            "principal_type": {
                              "type": "string",
                              "enum": [
                                "user",
                                "group",
                                "workspace"
                              ]
                            },
                            "principal_id": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "recipient_type",
                            "principal_type",
                            "principal_id"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "recipient_type": {
                              "type": "string",
                              "const": "email"
                            },
                            "email": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "recipient_type",
                            "email"
                          ]
                        }
                      ]
                    },
                    "recipient_display_name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "recipient_email": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "recipient_avatar_url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "role_id": {
                      "type": "string",
                      "description": "Current Library folder role ID."
                    },
                    "inviter": {
                      "type": "object",
                      "properties": {
                        "principal_type": {
                          "type": "string",
                          "enum": [
                            "user",
                            "group",
                            "workspace"
                          ]
                        },
                        "principal_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "principal_type",
