    {
      "server_name": "codex_apps",
      "supports_parallel_tool_calls": false,
      "server_origin": null,
      "tool_name": "_get_artifact_execution_status",
      "tool_namespace": "codex_apps__chatgpt_space",
      "namespace_description": "Read, search, create, and edit pages and spaces in ChatGPT Space, within your current account.",
      "tool": {
        "name": "chatgpt_space.get_artifact_execution_status",
        "title": "get_artifact_execution_status",
        "description": "Check whether an earlier execute_artifact_code request committed its changes. Use the original page_id and idempotency_key after acceptance, a timeout, or a lost response. This checks the whole execution request. It does not report live progress or recover the callback's return value. Unknown means no commit is confirmed. It does not make rerunning the code with a new idempotency_key safe.",
        "inputSchema": {
          "$defs": {
            "PageCreationIdempotencyKey": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Identify a callback to execute or an earlier callback whose outcome needs checking.",
          "properties": {
            "page_id": {
              "description": "Page ID of the target artifact, not the parent Page ID, and never a Space ID. For a URL, use only the ID in /space/{page_id}, without query parameters.",
              "maxLength": 256,
              "minLength": 1,
              "title": "Page Id",
              "type": "string"
            },
            "idempotency_key": {
              "$ref": "#/$defs/PageCreationIdempotencyKey",
              "description": "Required idempotency key. Use a new key for each edit within this task. After an uncertain response, reuse the same key and edit arguments for a retry; use that key for status lookup."
            }
          },
          "required": [
            "page_id",
            "idempotency_key"
          ],
          "title": "ArtifactExecutionArguments",
          "type": "object"
        },
        "outputSchema": {
          "type": "object",
          "anyOf": [
            {
              "description": "Describe edit receipts with the caller's recovery key.",
              "properties": {
                "page_id": {
                  "title": "Page Id",
                  "type": "string"
                },
                "status": {
                  "description": "committed confirms a saved edit. accepted means the realtime service accepted the edit for persistence, but it is not yet confirmed saved. no_changes means no delta was produced. rejected means the edit was not saved. unknown means the outcome is uncertain. not_found means no operation was recorded for this request ID.",
                  "enum": [
                    "committed",
                    "accepted",
                    "no_changes",
                    "rejected",
                    "unknown",
                    "not_found"
                  ],
                  "title": "ArtifactOperationStatus",
                  "type": "string"
                },
                "observed_sequence": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Canonical sequence of the snapshot supplied to the callback.",
                  "title": "Observed Sequence"
                },
                "committed_sequence": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Canonical sequence where this operation's delta was saved.",
                  "title": "Committed Sequence"
                },
                "result": {
                  "default": null,
                  "description": "Callback return value, limited to 16 KiB of serialized JSON. Not stored in the commit receipt."
                },
                "result_omitted": {
                  "default": false,
                  "description": "True when oversized callback JSON was omitted. Does not indicate whether an edit committed.",
                  "title": "Result Omitted",
                  "type": "boolean"
                },
                "result_message": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Explains omitted callback data separately from the commit outcome.",
                  "title": "Result Message"
                },
                "rendered_images": {
                  "anyOf": [
                    {
                      "items": {
                        "additionalProperties": false,
                        "description": "Bounded, byte-free metadata for an image returned only to this tool call.",
                        "properties": {
                          "file_name": {
                            "maxLength": 256,
                            "minLength": 1,
                            "title": "File Name",
                            "type": "string"
                          },
                          "mime_type": {
                            "pattern": "^image/png$",
                            "title": "Mime Type",
                            "type": "string"
                          },
                          "sha256": {
                            "pattern": "^[0-9a-f]{64}$",
                            "title": "Sha256",
                            "type": "string"
                          },
                          "byte_length": {
                            "maximum": 4194304,
                            "minimum": 1,
                            "title": "Byte Length",
                            "type": "integer"
                          }
                        },
                        "required": [
                          "file_name",
                          "mime_type",
                          "sha256",
                          "byte_length"
                        ],
                        "title": "ArtifactRenderMetadata",
                        "type": "object"
                      },
                      "maxItems": 4,
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Metadata for PNG QA renders returned as image content in this response. The images are transient: they are not uploaded, saved, or available from status lookup.",
                  "title": "Rendered Images"
                },
                "error_code": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Machine-readable failure or uncertainty code.",
                  "title": "Error Code"
                },
                "error_message": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Safe explanation of the failure and any available recovery steps.",
                  "title": "Error Message"
                },
                "retryable": {
                  "default": false,
                  "description": "True only for a definitive transient rejection before a write was attempted. For an edit, retry with a new idempotency_key as error_message directs; an unknown outcome instead requires status lookup.",
                  "title": "Retryable",
                  "type": "boolean"
                },
                "error_details": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "description": "Bounded callback error details for its caller, not server diagnostics.",
                      "properties": {
                        "name": {
                          "maxLength": 128,
                          "title": "Name",
                          "type": "string"
                        },
                        "message": {
                          "maxLength": 2048,
                          "title": "Message",
                          "type": "string"
                        },
                        "stack": {
                          "items": {
                            "maxLength": 128,
                            "type": "string"
                          },
                          "maxItems": 8,
                          "title": "Stack",
                          "type": "array"
                        },
                        "truncated": {
                          "title": "Truncated",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "message",
                        "stack",
                        "truncated"
                      ],
                      "title": "ArtifactCallbackDiagnostic",
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Callback error name, message and callback-only stack locations. Available for code errors, not infrastructure failures. No edit was saved."
                },
                "idempotency_key": {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:-]+$",
                  "type": "string",
                  "description": "Original edit key. Reuse it for status lookup or retries in the same task."
                },
                "request_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "deprecated": true,
                  "description": "Legacy backend operation ID, when returned. Use idempotency_key for recovery.",
                  "title": "Request Id"
                },
                "document_type": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Page document type, when known by the backend.",
                  "title": "Document Type"
                }
              },
              "required": [
                "page_id",
                "status",
                "idempotency_key"
              ],
              "title": "ArtifactExecutionResponse",
              "type": "object"
            },
            {
              "description": "Connector error returned instead of an execution result.",
              "properties": {
                "error": {
                  "description": "Connector failure envelope, distinct from a completed backend execution.",
                  "properties": {
                    "message": {
                      "title": "Message",
                      "type": "string"
                    },
                    "code": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Code"
                    },
                    "commit_status": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Commit Status"
                    },
                    "retryable": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "title": "Retryable"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "title": "ArtifactToolError",
                  "type": "object"
                }
              },
              "required": [
                "error"
              ],
              "title": "ArtifactToolErrorResponse",
              "type": "object"
            }
          ]
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "_meta": {
          "resource_name": "chatgpt_space.get_artifact_execution_status",
          "_codex_apps": {
            "resource_uri": "/connector_openai_pages/implicit_link::connector_openai_pages/get_artifact_execution_status",
            "contains_mcp_source": true
