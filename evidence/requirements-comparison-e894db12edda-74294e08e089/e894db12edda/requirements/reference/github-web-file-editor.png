                      ]
                    },
                    "expires_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "share_id",
                    "recipient",
                    "role_id",
                    "inviter",
                    "status"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "deleted"
                  ]
                }
              ],
              "description": "The successful Drive sharing response, retained when the roster refresh is unavailable. Do not replay this write; this response describes only the direct grant, not all effective access."
            },
            "workspace_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Canonical owning workspace for Library sharing, or null for a personal account."
            },
            "page_id": {
              "type": "string"
            },
            "space_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "page_and_backing_library_folder",
                "space_and_backing_library_folder"
              ],
              "description": "Space-root reads return Space scope and space_id; use the Space sharing tools for changes."
            },
            "backing_type": {
              "type": "string",
              "const": "drive"
            },
            "sharing_available": {
              "type": "boolean"
            },
            "concurrency": {
              "type": "string",
              "const": "no_revision_precondition"
            },
