      "tool_name": "_validate_suggested_schedule",
      "tool_namespace": "codex_apps__sites",
      "namespace_description": "Use Sites to build or modify websites, including landing pages, portfolios, dashboards, portals, trackers, hubs, and internal tools. Use Sites skills for local implementation, source preparation, and artifact packaging. Use this connector for site creation, runtime environment variables, versions, production deployments, and access controls. Read .openai/hosting.json before creating a site and reuse its project_id when present. Treat Sites IDs and cursors as opaque: copy them exactly from .openai/hosting.json or Sites responses as applicable, and never invent, reformat, derive, or substitute them. Never call create_site more than once for the same local site. Push the exact source state before saving a version. commit_sha must identify that pushed state, and any archive must be built from it. Deploy only saved versions; every Sites deployment URL is production. Inspect deployment status when the initial result is non-terminal or the user asks for progress. Publish after creating or editing a site by default, including on subsequent turns, unless the user explicitly requested local-only work, a saved version without deployment, or no publishing. New sites start private. Preserve the site's current audience unless the user explicitly requests a different audience. Use the private operation for known owner-private sites and let it enforce owner-only access. Runtime tool approvals and backend access checks still apply without a separate conversational deployment confirmation.",
      "tool": {
        "name": "sites.validate_suggested_schedule",
        "title": "validate_suggested_schedule",
        "description": "Validate a model-proposed cloud schedule for a published Site and return it for the user to set up. Read get_site first and skip Sites with existing automations. Supply a concise recurring task and its sources; include timing only when the user specified it. Checks Site ownership, publication, and existing schedules; it does not generate the proposal or validate whether the task can execute. Returns no suggestion when a schedule is already attached. Never creates or enables a task. For an explicit user request for recurring Site work, use Sites create_schedule after publication. Confirm scheduling only from the real task creation result.",
        "inputSchema": {
          "properties": {
            "project_id": {
              "title": "Project Id",
              "type": "string"
            },
            "schedule_suggestion": {
              "properties": {
                "title": {
                  "maxLength": 200,
                  "minLength": 1,
                  "title": "Title",
                  "type": "string"
                },
                "prompt": {
                  "maxLength": 8000,
                  "minLength": 1,
                  "title": "Prompt",
                  "type": "string"
                },
                "schedule": {
                  "anyOf": [
                    {
                      "maxLength": 1000,
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "An RRULE only when the user specified timing; otherwise omit it for setup.",
                  "title": "Schedule"
                }
              },
              "required": [
                "title",
                "prompt"
              ],
              "title": "SitesScheduleSuggestion",
              "type": "object",
              "additionalProperties": false
            }
          },
          "required": [
            "project_id",
            "schedule_suggestion"
          ],
          "title": "SitesSuggestScheduleRequest",
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "properties": {
            "project_id": {
              "title": "Project Id",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "current_live_url": {
              "title": "Current Live Url",
              "type": "string"
            },
            "schedule_suggestion": {
              "anyOf": [
                {
                  "properties": {
                    "title": {
                      "maxLength": 200,
                      "minLength": 1,
                      "title": "Title",
                      "type": "string"
                    },
                    "prompt": {
                      "maxLength": 8000,
                      "minLength": 1,
                      "title": "Prompt",
                      "type": "string"
                    },
                    "schedule": {
                      "anyOf": [
                        {
                          "maxLength": 1000,
                          "minLength": 1,
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null,
                      "description": "An RRULE only when the user specified timing; otherwise omit it for setup.",
                      "title": "Schedule"
                    }
                  },
                  "required": [
                    "title",
                    "prompt"
                  ],
                  "title": "SitesScheduleSuggestion",
                  "type": "object",
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "project_id",
            "title",
            "current_live_url",
            "schedule_suggestion"
          ],
          "title": "SitesSuggestScheduleResponse",
          "type": "object",
          "additionalProperties": false
        },
        "annotations": {
